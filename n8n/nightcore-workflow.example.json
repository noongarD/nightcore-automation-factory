      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [
        20,
        -120
      ],
      "id": "9cfbc8b2-da5d-4e4c-85fa-381cd762c2c7",
      "name": "Upload short"
    }
  ],
